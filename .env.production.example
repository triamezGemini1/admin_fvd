# Copie a .env en el servidor: public_html/admin_fvd/.env
# NO subir .env al repositorio.

# --- Entorno ---
FVD_APP_ENV=production
FVD_BASE_PATH=/admin_fvd
FVD_PUBLIC_URL=https://federacionvenezolanadedomino.com/admin_fvd

# --- Base de datos PRINCIPAL (login, panel, torneos, finanzas) ---
# Formato URL (preferido): DB_PORTAL_URL=mysql://usuario:contraseña@localhost:3306/su_prefijo_fvdmasteradmin?charset=utf8mb4
# Formato legacy (alternativo):
FVD_DB_HOST=localhost
FVD_DB_PORT=3306
FVD_DB_DATABASE=su_prefijo_fvdmasteradmin
FVD_DB_USERNAME=su_usuario_mysql
# Si la contraseña tiene $ u otros símbolos, use comillas:
FVD_DB_PASSWORD="su_contraseña"

# --- BD personas (dbo_persona) — dominio laestaciondeldominohoy.com ---
# Formato URL (preferido remoto): DB_PERSONAS_URL=mysql://usuario:contraseña@laestaciondeldominohoy.com:3306/laestaci1_fvdadmin?charset=utf8mb4
# IMPORTANTE: solo prefijo FVD_PERSONA_DB_* (nunca FVD_DB_* en este bloque).
# Misma cuenta cPanel que el portal → host localhost.
# Otra cuenta/servidor → host = laestaciondeldominohoy.com + MySQL remoto en cPanel.
# FVD_PERSONA_DB_DISABLED=1
FVD_PERSONA_DB_HOST=localhost
FVD_PERSONA_DB_PORT=3306
FVD_PERSONA_DB_DATABASE=laestaci1_fvdadmin
# Usuario MySQL de la BD personas (cPanel): NO reutilice federaci1_lacancion del portal
FVD_PERSONA_DB_USERNAME=federaci1_soloyo
FVD_PERSONA_DB_PASSWORD="su_contraseña_personas"
FVD_PERSONA_DB_TABLE=dbo_persona

# Diagnóstico (activar mientras depura; luego FVD_APP_DEBUG=0)
# FVD_HEALTH_KEY=clave_secreta
# FVD_APP_DEBUG=1
#
# NO repita FVD_DB_DATABASE / FVD_DB_USERNAME / FVD_DB_PASSWORD al final.
# Ver plantilla completa: docs/ENV_SERVIDOR_EJEMPLO.env
