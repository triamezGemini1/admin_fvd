# Copie a .env y ajuste en su máquina (no subir .env al repositorio).
# Producción: use .env.production.example como plantilla (dominio + /admin_fvd).

# Entorno: development | production
FVD_APP_ENV=development
# Ruta pública bajo el dominio (local WAMP suele ser /admin_fvd/)
FVD_BASE_PATH=/admin_fvd
# FVD_PUBLIC_URL=https://federacionvenezolanadedomino.com/admin_fvd

# Formato URL (preferido en producción TCP/IP remota):
# DB_PORTAL_URL=mysql://usuario:contraseña@127.0.0.1:3306/fvdmasteradmin?charset=utf8mb4
# DB_PERSONAS_URL=mysql://usuario:contraseña@laestaciondeldominohoy.com:3306/personas?charset=utf8mb4

FVD_DB_HOST=127.0.0.1
FVD_DB_PORT=3306
FVD_DB_DATABASE=fvdmasteradmin
FVD_DB_USERNAME=root
FVD_DB_PASSWORD=

# Opcional: mismas credenciales para portal y personas (dos dominios distintos)
# FVD_MYSQL_USERNAME=root
# FVD_MYSQL_PASSWORD=

# BD externa personas (dbo_persona) — consulta al solicitar afiliación (api/check_user.php)
# Copie este bloque a su .env. Sin .env, en local se usa por defecto base "personas".
# Desactivar búsqueda externa: FVD_PERSONA_DB_DISABLED=1
FVD_PERSONA_DB_HOST=127.0.0.1
FVD_PERSONA_DB_PORT=3306
FVD_PERSONA_DB_DATABASE=personas
# Vacío = reutiliza FVD_DB_USERNAME / FVD_DB_PASSWORD
# FVD_PERSONA_DB_USERNAME=
# FVD_PERSONA_DB_PASSWORD=
FVD_PERSONA_DB_TABLE=dbo_persona
